    local relativeX = math.clamp((input.Position.X - trackPos) / trackSize, 0, 1)
    
    HBFill.Size = UDim2.new(relativeX, 0, 1, 0)
    HBButton.Position = UDim2.new(relativeX, -6, -0.5, 0)
    
    HitboxSizeVal = math.floor(relativeX * 49) + 1
    HitboxSliderTitle.Text = "Hitbox Size: " .. tostring(HitboxSizeVal) .. " / 50 Studs"
end

HBTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        hbSliding = true
        updateHBSlider(input)
    end
end)

